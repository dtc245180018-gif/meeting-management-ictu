POSTGRES_DB=meeting_management
POSTGRES_USER=meeting_user
POSTGRES_PASSWORD=meeting_password
DATABASE_URL=postgresql+psycopg://meeting_user:meeting_password@db:5432/meeting_management
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep /api for the Docker Nginx reverse proxy. Set an absolute URL only when
# the frontend is hosted separately from the backend.
VITE_API_URL=/api
