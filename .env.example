POSTGRES_DB=meeting_management
POSTGRES_USER=meeting_user
POSTGRES_PASSWORD=meeting_password
DATABASE_URL=postgresql+psycopg://meeting_user:meeting_password@db:5432/meeting_management
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAILS=dtc245180018@ictu.edu.vn
LEADER_EMAIL=dtc245180018@ictu.edu.vn
EMPLOYEE_ONE_EMAIL=ngocthang18092006@gmail.com
EMPLOYEE_TWO_EMAIL=tn9728160@gmail.com
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
REMINDER_MAX_ATTEMPTS=3
NOTIFICATION_RETENTION_DAYS=30
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_ALLOWED_DOMAIN=ictu.edu.vn
SPRINT3_SEED_ACCOUNTS=true
SPRINT3_CREDENTIALS_FILE=sprint3_credentials.local.csv
AUTH_REQUIRED=true
# Generate a private value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_MINUTES=480
CHATBOT_CONFIRMATION_MINUTES=10
QR_TOKEN_MINUTES=720
QR_CHECKIN_EARLY_MINUTES=30
QR_CHECKOUT_GRACE_MINUTES=60
# Gemini is called only by the backend. Never expose this key as a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
INITIAL_ACCOUNT_PASSWORD=ICTU123
HRM_CONNECTOR=mock
HRM_MOCK_DATA_FILE=data/hrm_mock.json
HRM_DEFAULT_ROLE=participant
HRM_SYNC_INTERVAL_MINUTES=0
# Keep /api for the Docker Nginx reverse proxy. Set an absolute URL only when
# the frontend is hosted separately from the backend.
VITE_API_URL=/api
