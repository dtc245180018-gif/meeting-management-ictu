DATABASE_URL=sqlite:///./meeting_management.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAILS=dtc245180018@ictu.edu.vn
LEADER_EMAIL=dtc245180018@ictu.edu.vn
EMPLOYEE_ONE_EMAIL=ngocthang18092006@gmail.com
EMPLOYEE_TWO_EMAIL=tn9728160@gmail.com
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
REMINDER_MAX_ATTEMPTS=3
NOTIFICATION_RETENTION_DAYS=30
FRONTEND_URL=http://localhost:5173

# Google Calendar API (OAuth 2.0 Web application)
# Callback được khai báo trong Google Cloud phải trùng tuyệt đối GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Chuỗi ngẫu nhiên dài, độc lập với khóa mã hóa token.
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_ALLOWED_DOMAIN=ictu.edu.vn

# Sprint 3 account foundation. The generated CSV contains temporary passwords
# and must remain local; it is excluded from Git.
SPRINT3_SEED_ACCOUNTS=true
SPRINT3_CREDENTIALS_FILE=sprint3_credentials.local.csv

# Authentication / RBAC. Use a random value of at least 32 characters and
# never commit the real key.
AUTH_REQUIRED=true
AUTH_SECRET_KEY=
AUTH_TOKEN_MINUTES=480
CHATBOT_CONFIRMATION_MINUTES=10
QR_TOKEN_MINUTES=720
QR_CHECKIN_EARLY_MINUTES=30
QR_CHECKOUT_GRACE_MINUTES=60
# Gemini conversational assistant. Create the key in Google AI Studio and keep
# the real value only in backend/.env (this file is a safe template).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
INITIAL_ACCOUNT_PASSWORD=ICTU123
HRM_CONNECTOR=mock
HRM_MOCK_DATA_FILE=data/hrm_mock.json
HRM_DEFAULT_ROLE=participant
# 0 disables periodic synchronization; manual Admin sync remains available.
HRM_SYNC_INTERVAL_MINUTES=0
