# Local secrets and runtime data must never enter a deployment bundle.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Local development environments and generated data.
.git/
.vercel/
**/.venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/dist/
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.local.csv
release/
